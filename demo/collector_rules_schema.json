{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checkpoint Gate Collector Rules",
  "description": "Schema for git-backed collector rule files.",
  "type": "object",
  "required": ["roadmap_name", "checkpoints"],
  "properties": {
    "roadmap_name": {
      "type": ["string", "null"]
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    }
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "required": ["key", "name", "done_evidence", "gate"],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "done_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "gate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["label", "type", "path"],
          "properties": {
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file_exists"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["label", "type"],
          "properties": {
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "git_status_clean"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
